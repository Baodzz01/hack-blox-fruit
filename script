-- 4. Movement Modifiers (Fly, Speed, High Jump)
local BodyVelocity, BodyGyro
local function UpdateFly(active)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if active then
        BodyVelocity = Instance.new("BodyVelocity")
        BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        BodyVelocity.Velocity = Vector3.new(0, 0, 0)
        BodyVelocity.Parent = hrp
        
        BodyGyro = Instance.new("BodyGyro")
        BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        BodyGyro.CFrame = hrp.CFrame
        BodyGyro.Parent = hrp
    else
        if BodyVelocity then BodyVelocity:Destroy() end
        if BodyGyro then BodyGyro:Destroy() end
    end
end

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if humanoid then
        if Config.Speed > 16 then
            humanoid.WalkSpeed = Config.Speed
        end
        if Config.HighJump > 50 then
            humanoid.JumpPower = Config.HighJump
        end
    end

    if Config.Fly and hrp and BodyVelocity and BodyGyro then
        local camCFrame = Camera.CFrame
        local moveDir = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camCFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camCFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camCFrame.RightVector end
        
        BodyVelocity.Velocity = moveDir * Config.FlySpeed
        BodyGyro.CFrame = camCFrame
    end
end)

-- 5. ESP System (Players & Mobs)
local espCache = {}
local function createESP(object, color, nameText)
    if espCache[object] then return end
    local bill = Instance.new("BillboardGui")
    bill.Name = "BaodzESP"
    bill.Size = UDim2.new(0, 100, 0, 40)
    bill.AlwaysOnTop = true
    bill.StudsOffset = Vector3.new(0, 2.5, 0)
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = color
    textLabel.TextScaled = true
    textLabel.TextStrokeTransparency = 0
    textLabel.Text = nameText
    textLabel.Parent = bill
    
    if object:IsA("Model") and object:FindFirstChild("HumanoidRootPart") then
        bill.Parent = object.HumanoidRootPart
        espCache[object] = bill
    elseif object:IsA("BasePart") then
        bill.Parent = object
        espCache[object] = bill
    end
end

local function clearESP()
    for obj, bill in pairs(espCache) do
        if bill then bill:Destroy() end
    end
    espCache = {}
end

RunService.RenderStepped:Connect(function()
    clearESP()
    if Config.EspPlayer then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                createESP(p.Character, Color3.fromRGB(255, 0, 0), p.Name)
            end
        end
    end
    if Config.EspMob then
        local enemies = Workspace:FindFirstChild("Enemies")
        if enemies then
            for _, mob in ipairs(enemies:GetChildren()) do
                if mob:FindFirstChild("HumanoidRootPart") and mob:FindFirstChildOfClass("Humanoid") then
                    if mob.Humanoid.Health > 0 then
                        createESP(mob, Color3.fromRGB(255, 165, 0), mob.Name)
                    end
                end
            end
        end
    end
end)

-- 6. Aimbot Module
RunService.RenderStepped:Connect(function()
    if not Config.Aimbot then return end
    local nearestTarget = nil
    local shortestDist = math.huge
    
    local enemies = Workspace:FindFirstChild("Enemies")
    local targets = {}
    if enemies then
        for _, e in ipairs(enemies:GetChildren()) do
            table.insert(targets, e)
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            table.insert(targets, p.Character)
        end
    end
    
    for _, target in ipairs(targets) do
        local hrp = target:FindFirstChild("HumanoidRootPart")
        local hum = target:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
            if onScreen then
                local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    nearestTarget = hrp
                end
            end
        end
    end
    
    if nearestTarget then
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, nearestTarget.Position)
    end
end)

